# Copy this file to .env and fill in real values.
# .env itself should never be committed to version control.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Only used when FLASK_ENV=production
DATABASE_URL=postgresql://user:password@localhost:5432/moviestream

# Only used when FLASK_ENV=development (optional override; defaults to SQLite in instance/)
DEV_DATABASE_URL=sqlite:///instance/moviestream.db

# Max movie file size for /upload, in gigabytes. Defaults to 20 if unset.
# Raise this if your movie files are larger.
MAX_UPLOAD_SIZE_GB=20
