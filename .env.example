# Copy this file to .env and fill in real values.
# .env itself should never be committed to version control.

FLASK_ENV=development
# Required in production (the app refuses to start without it).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Default admin created on first run when the users table is empty.
# Without ADMIN_PASSWORD, the admin123 fallback is only used in development.
ADMIN_EMAIL=admin@moviestream.com
ADMIN_PASSWORD=

# Only used when FLASK_ENV=production
DATABASE_URL=postgresql://user:password@localhost:5432/moviestream

# Only used when FLASK_ENV=development (optional override; defaults to SQLite in instance/)
DEV_DATABASE_URL=sqlite:///instance/moviestream.db

# Max movie file size for /upload, in gigabytes. Defaults to 20 if unset.
# Raise this if your movie files are larger.
MAX_UPLOAD_SIZE_GB=20
